@@ -9,8 +9,8 @@
 }
 
 .ptr.to.raw <- function(ptr, begin, length)
-    .Call("ptr_to_raw", ptr, begin, length, PACKAGE="Cairo")
+    .Call("ptr_to_raw", ptr, begin, length, PACKAGE="RCairo")
 
 .raw.to.ptr <- function(ptr, offset=0, raw, begin=0, length=length(raw))
-    invisible(.Call("raw_to_ptr", ptr, offset, raw, begin, length, PACKAGE="Cairo"))
+    invisible(.Call("raw_to_ptr", ptr, offset, raw, begin, length, PACKAGE="RCairo"))
 
diff --git a/R/zzz.R b/R/zzz.R
index 36723a8..40a9a73 100644
--- a/R/zzz.R
+++ b/R/zzz.R
@@ -5,6 +5,6 @@
         cp<-strsplit(Sys.getenv("PATH"),";")
         if (! lp %in% cp) Sys.setenv(PATH=paste(lp,Sys.getenv("PATH"),sep=";"))
     }
-    library.dynam("Cairo", pkgname, libname)
-    .Call("Rcairo_initialize", PACKAGE="Cairo")
+    library.dynam("RCairo", pkgname, libname)
+    .Call("Rcairo_initialize", PACKAGE="RCairo")
 }
diff --git a/src/cairotalk.c b/src/cairotalk.c
index 7dde22c..3ccd7e9 100644
--- a/src/cairotalk.c
+++ b/src/cairotalk.c
@@ -1835,7 +1835,7 @@ static const R_ExternalMethodDef externalMethods[] = {
     {NULL, NULL, 0}
 };
 
-void attribute_visible R_init_Cairo(DllInfo *dll) {
+void attribute_visible R_init_RCairo(DllInfo *dll) {
 	R_registerRoutines(dll, 0, callMethods, 0, externalMethods);
     R_useDynamicSymbols(dll, FALSE);
     /* R_forceSymbols(dll, TRUE); */
diff --git a/src/install.libs.R b/src/install.libs.R
new file mode 100644
index 0000000..d2d5e8c
--- /dev/null
+++ b/src/install.libs.R
@@ -0,0 +1,26 @@
+# Install the compiled package library under the name "RCairo" instead of
+# "Cairo", to avoid a Windows DLL base-name clash with the external cairo
+# library (shipped by conda-forge as Library/bin/cairo.dll). Windows matches
+# module names case-insensitively, so a package DLL named Cairo.dll satisfies
+# its own import of cairo.dll and the real cairo exports are never found
+# ("LoadLibrary failure: The specified procedure could not be found").
+# Matching names live in library.dynam("RCairo", ...) / PACKAGE="RCairo" in
+# R/*.R and in R_init_RCairo() in src/cairotalk.c.
+#
+# Mirrors tools:::.install_packages() default logic (glob built shared objects,
+# copy into libs[/arch]), renaming only the main library.
+
+files <- Sys.glob(paste0("*", SHLIB_EXT))
+
+dest <- file.path(R_PACKAGE_DIR, paste0("libs", R_ARCH))
+dir.create(dest, recursive = TRUE, showWarnings = FALSE)
+
+main <- paste0(R_PACKAGE_NAME, SHLIB_EXT)          # Cairo.dll / Cairo.so
+for (f in files) {
+  target <- if (identical(f, main)) paste0("R", main) else f
+  file.copy(f, file.path(dest, target), overwrite = TRUE)
+}
+
+if (file.exists("symbols.rds")) {
+  file.copy("symbols.rds", dest, overwrite = TRUE)
+}
