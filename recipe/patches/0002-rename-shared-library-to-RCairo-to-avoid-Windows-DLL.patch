+++ b/R/imgtools.R
@@ -1,5 +1,5 @@
 .image <- function(device) {
-    a <- .Call("get_img_backplane", device, PACKAGE="Cairo")
+    a <- .Call("get_img_backplane", device, PACKAGE="RCairo")
